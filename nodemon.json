{
  "watch": ["src", "prisma"],
  "ext": "ts,js,json",
  "ignore": ["src/**/*.test.ts", "src/**/*.spec.ts", "dist", "node_modules"],
  "exec": "node --import ./scripts/register-dev-loaders.mjs --experimental-specifier-resolution=node src/server.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "signal": "SIGTERM",
  "delay": "1000"
}
