# Core Environment
NODE_ENV=development
TZ=UTC
PORT=8080
SERVICE_NAME=nodcord-api
BASE_URL=http://localhost:8080

# API Configuration
API_VERSION=v1
API_STATUS=online
API_BASE_URL=http://localhost:8080
API_HTTPS=false
API_PORT=8080
API_KEY=
BOT_API_KEY=

# Client Configuration
CLIENT_BASE_URL=http://localhost:4000
CLIENT_HTTPS=false
CLIENT_PORT=4000
SESSION_SECRET=change_me

# Discord / Bot
BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_BOT_PREFIX=!
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_DEV_GUILD_ID=
DEV_GUILD_ID=
DISCORD_REPORT_CHANNEL=
DISCORD_SUPPORT_SERVER=
CLIENT_ID=
OWNER_ID=

# JWT / Authentication
JWT_SECRET=
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALG=RS256
JWT_ISSUER=nodcord
JWT_AUDIENCE=nodcord-users
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
JWT_CLOCK_TOLERANCE=2s
ACCESS_TOKEN_SECRET=

# Cookies & CSRF
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CSRF_SECRET=

# Database & Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/nodcord
PROD_DATABASE_URL=
DEV_DATABASE_URL=
TEST_DATABASE_URL=
STAGING_DATABASE_URL=
DATABASE_STATUS=online
DISABLE_PRISMA=false

# Monitoring & Integrations
CLOUDNET_STATUS=online
CLOUDNET_VERSION=
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_BASE_URL=
SMS_FROM=
SMS_MAX_RETRIES=3
SMS_RETRY_DELAY_MS=1000
SMS_RATE_LIMIT_MS=1000

# Email (SMTP / Contact)
CONTACT_EMAIL=support@example.com
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Seed Data
SEED_DEFAULT_USER_PASSWORD=ChangeMe123!
SEED_BCRYPT_COST=12
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_MODERATOR_USERNAME=moderator
SEED_MODERATOR_EMAIL=moderator@example.com
SEED_USER_USERNAME=user
SEED_USER_EMAIL=user@example.com

# Stripe / Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:4000/checkout/success
STRIPE_CANCEL_URL=http://localhost:4000/checkout/cancel

# AI Provider
PUBLIC_AI_PROVIDER=huggingface
PUBLIC_AI_MODEL=mistralai/Mistral-7B-Instruct-v0.2
PUBLIC_AI_ENDPOINT=
PUBLIC_AI_API_KEY=
PUBLIC_AI_TIMEOUT_MS=25000
